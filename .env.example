# ======================================
# MODEL GATEWAY -- DEVELOPMENT ENVIRONMENT EXAMPLE
# ======================================
# DEVELOPMENT ONLY. This file is a local development convenience, not a
# production reference -- see .env.production.example for production.
#
# Copy to .env and fill in the keys. Every value here is an example: swap the
# endpoints, model IDs and formats for whatever provider you want, without
# touching gateway code. FORMAT is the LiteLLM provider dialect name handed to
# the inference binding; the operation performed is determined by which
# capability block the variable sits in (TEXT_LLM_* = chat, EMBEDDINGS_* =
# embeddings, IMAGE_GEN_* = images). The gateway composes
# "<FORMAT>/<MODEL_ID>" and hands it to LiteLLM along with ENDPOINT as the
# base URL.

# ======================================
# SERVER
# ======================================
CHORA_HTTP_PORT=8080
CHORA_GRPC_PORT=9090
CHORA_ENVIRONMENT=development
LOG_LEVEL=info

# ======================================
# TEXT GENERATION
# ======================================
# Anthropic Messages protocol on a compatible third-party endpoint.
# LiteLLM appends "/v1/messages" to TEXT_LLM_ENDPOINT, so do not include it.
TEXT_LLM_ENDPOINT=https://api.longcat.ai/anthropic
TEXT_LLM_MODEL_ID=LongCat-2.5-Preview
TEXT_LLM_API_KEY=
TEXT_LLM_FORMAT=anthropic
# For known providers the inference binding selects the provider's own auth
# header, so TEXT_LLM_AUTH_TYPE matters only for custom endpoints.
TEXT_LLM_AUTH_TYPE=bearer
TEXT_LLM_PATH=
# An absolute URL in TEXT_LLM_PATH is rejected unless this opt-in is set.
TEXT_LLM_ALLOW_ABSOLUTE_PATH_URL=false
TEXT_LLM_EXTRA_HEADERS_JSON={}
TEXT_LLM_CAPABILITIES=chat,tools
TEXT_LLM_CONTEXT_WINDOW=
TEXT_LLM_MAX_OUTPUT_TOKENS=
# JSON array of ADDITIONAL routes appended after the singleton primary route
# above. Each entry is self-contained: nothing is inherited from the singleton
# block. It supplies its own endpoint, model ID and format, plus any
# authentication configuration and credentials that route requires. Any
# capability omitted from an entry defaults to only the operation's base
# capability and is not inherited from the primary route, so "fallback" does
# not mean "equivalent provider". Do not set this while the singleton block is
# unset.
TEXT_LLM_ROUTES_JSON=[]
# The indexed form (TEXT_LLM_1_*, TEXT_LLM_2_*) is not supported and is
# rejected at startup.

# ======================================
# IMAGE GENERATION
# ======================================
# OpenAI-compatible images endpoint: LiteLLM POSTs to
#   {ENDPOINT}/images/generations
# through its image API.
# For an unrecognised image model, passing response_format (and possibly size)
# makes LiteLLM raise UnsupportedParamsError; drop those parameters or do not
# advertise them for such routes.
IMAGE_GEN_ENDPOINT=https://api.meta.ai/v1
IMAGE_GEN_MODEL_ID=muse-image-1.0
IMAGE_GEN_API_KEY=
IMAGE_GEN_FORMAT=openai
# For known providers the inference binding selects the provider's own auth
# header, so IMAGE_GEN_AUTH_TYPE matters only for custom endpoints.
IMAGE_GEN_AUTH_TYPE=bearer
IMAGE_GEN_PATH=
# An absolute URL in IMAGE_GEN_PATH is rejected unless this opt-in is set.
IMAGE_GEN_ALLOW_ABSOLUTE_PATH_URL=false
IMAGE_GEN_EXTRA_HEADERS_JSON={}
IMAGE_GEN_CAPABILITIES=generation
# JSON array of ADDITIONAL routes appended after the singleton primary route
# above. Each entry is self-contained: nothing is inherited from the singleton
# block. It supplies its own endpoint, model ID and format, plus any
# authentication configuration and credentials that route requires. Any
# capability omitted from an entry defaults to only the operation's base
# capability and is not inherited from the primary route, so "fallback" does
# not mean "equivalent provider". Do not set this while the singleton block is
# unset.
IMAGE_GEN_ROUTES_JSON=[]
# The indexed form (IMAGE_GEN_1_*, IMAGE_GEN_2_*) is not supported and is
# rejected at startup.

# ======================================
# EMBEDDINGS
# ======================================
EMBEDDINGS_ENDPOINT=https://openrouter.ai/api/v1
EMBEDDINGS_MODEL_ID=liquid/lfm-2.5-embedding-350m:free
EMBEDDINGS_API_KEY=
EMBEDDINGS_FORMAT=openrouter
# For known providers the inference binding selects the provider's own auth
# header, so EMBEDDINGS_AUTH_TYPE matters only for custom endpoints.
EMBEDDINGS_AUTH_TYPE=bearer
EMBEDDINGS_PATH=
# An absolute URL in EMBEDDINGS_PATH is rejected unless this opt-in is set.
EMBEDDINGS_ALLOW_ABSOLUTE_PATH_URL=false
EMBEDDINGS_DIMENSIONS=
EMBEDDINGS_SUPPORTS_DIMENSIONS_PARAM=false
EMBEDDINGS_EXTRA_HEADERS_JSON={}
# JSON array of ADDITIONAL routes appended after the singleton primary route
# above. Each entry is self-contained: nothing is inherited from the singleton
# block. It supplies its own endpoint, model ID and format, plus any
# authentication configuration and credentials that route requires. Any
# capability omitted from an entry defaults to only the operation's base
# capability and is not inherited from the primary route, so "fallback" does
# not mean "equivalent provider". Do not set this while the singleton block is
# unset.
EMBEDDINGS_ROUTES_JSON=[]
# The indexed form (EMBEDDINGS_1_*, EMBEDDINGS_2_*) is not supported and is
# rejected at startup.

# ======================================
# AUTHENTICATION
# ======================================
# How clients authenticate TO the gateway. Upstream provider credentials are
# configured above and are never accepted from inference request bodies.
# For known providers LiteLLM selects the provider's own auth header, so
# *_AUTH_TYPE only matters for custom endpoints.
GATEWAY_AUTH_ENABLED=false
GATEWAY_API_KEYS=
GATEWAY_ALLOW_ANONYMOUS_HEALTH=true

# ======================================
# RELIABILITY
# ======================================
PROVIDER_TIMEOUT_SECONDS=110
PROVIDER_CONNECT_TIMEOUT_SECONDS=10
PROVIDER_RETRY_COUNT=2
PROVIDER_RETRY_BACKOFF_MS=500
PROVIDER_MAX_CONCURRENT_REQUESTS=100
GATEWAY_SHUTDOWN_TIMEOUT_SECONDS=30

# ======================================
# LIMITS
# ======================================
# Zero disables the two admission limiters; it does NOT disable the body bound,
# which has a default because a deployment that never set one is the one a limit
# protects. A value that is not a positive whole number is refused at startup.
GATEWAY_MAX_REQUEST_BODY_BYTES=16777216
GATEWAY_RATE_LIMIT_REQUESTS=0
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_TENANT_MAX_CONCURRENT_REQUESTS=0

# ======================================
# UPSTREAM ALLOWLIST
# ======================================
# Empty means no allowlist: every host the URL policy permits may be configured.
# An entry is a hostname only -- a scheme, a port, a path or an IPv6 literal is
# refused rather than ignored -- and a host named here still has to pass the
# gateway's own address screen, so this narrows what may be reached and never
# widens it. A route outside the list fails the start.
GATEWAY_ALLOWED_UPSTREAM_HOSTS=

# ======================================
# USAGE
# ======================================
USAGE_TRACKING_ENABLED=true
COST_TRACKING_ENABLED=false
USAGE_STORAGE=memory

# ======================================
# OBSERVABILITY
# ======================================
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
